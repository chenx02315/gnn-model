{
  "schema_version": "runtime-training-v1",
  "status": "DESIGN_FROZEN_DATASET_PACKAGE_PENDING",
  "purpose": "Train a family-isolated D95-safe cost-aware action ranker whose primary endpoint is cumulative Tessent process elapsed time to the first epsilon-near-optimal D95-safe action.",
  "authority": {
    "training_preflight_contract": "contracts/training_preflight_v1.json",
    "training_preflight_contract_sha256": "d13126edb1c8884d5af295aae8faa678b26a5fb8cbbe25deffa8f9f5fcb39f56",
    "training_preflight_receipt": "data/manifests/runtime_training_preflight_v1_20260928.json",
    "training_preflight_receipt_sha256": "181661635665da0242f0d044a40f0571075d07b582a1818f1f5c655e35bb0ae8",
    "training_preflight_independent_review": "data/manifests/runtime_training_preflight_v1_independent_review_20260928.json",
    "training_preflight_independent_review_sha256": "650d9fd0f1244a0b140b3da35c24df95f15102529651ae19e38c6677f07153b5",
    "split_contract": "contracts/data_split_v1.json",
    "split_contract_sha256": "ffecd5093453f69c11263501b822ad7bb8f7eefd5da60dd7863331088f6fbcda",
    "runtime_policy": "contracts/runtime_policy_v1.json",
    "runtime_policy_sha256": "03f6f5bb47b41dcf65357369582b81b30d15546b84b7a716901f2edd19e48586",
    "method_registry": "contracts/recommendation_method_registry_v1.json",
    "method_registry_sha256": "8fb8d4a90981c2479e3e6ea3a8a4669286080e921ad0c2ff8d82e8a2a5c4191f",
    "feature_schema": "contracts/runtime_feature_schema_v1.json",
    "feature_schema_sha256": "7b2a2ab793b06b67d4554532fc322a55a6d8f37c8bdbe63678237e52161b26b0"
  },
  "objective": {
    "fixed_modes": ["H64", "M16", "F4"],
    "fixed_order": {"HF": ["H64", "F4"], "HMF": ["H64", "M16", "F4"]},
    "d95_is_hard_constraint": true,
    "primary_endpoint": "cumulative_tessent_process_elapsed_s_to_epsilon_hit",
    "epsilon": 0.01,
    "top_k": 10,
    "near_optimal_reference": "minimum_measured_total_cycles_among_successful_d95_safe_actions_in_the_same_circuit",
    "ate_cycles_role": "near_optimal_hit_definition_only",
    "ate_cycles_are_runtime_labels": false
  },
  "formal_roles": {
    "TRAIN": ["s13207", "s15850", "s35932", "s38417", "aes_core", "spi"],
    "VALIDATION": ["s5378", "tv80"],
    "PILOT": ["b18", "b20", "b21", "b22"],
    "BLIND_TEST": ["s9234", "s38584", "wb_dma"],
    "roles_allowed_in_formal_training_package": ["TRAIN", "VALIDATION"],
    "pilot_allowed_for_training_or_selection": false,
    "blind_rows_allowed": false
  },
  "dataset_package": {
    "schema_version": "runtime-training-package-v1",
    "required_files": ["actions.tsv", "action_attempt_edges.tsv", "attempts.tsv", "graph_manifest.tsv", "source_attempt_inventory.tsv", "retry_completeness_evidence.json", "retry_completeness_review.json"],
    "actions_required_fields": [
      "role", "family", "circuit", "action_uid", "action_scheme", "h_limit", "m_limit",
      "common_fault_count", "execution_status", "is_d95_feasible", "total_cycles", "graph_key"
    ],
    "edges_required_fields": [
      "action_uid", "invocation_order", "mode", "retry_group_id", "attempt_id", "prefix_key"
    ],
    "attempts_schema": "src/data/runtime_schema.py:MANIFEST_V2_FIELDS",
    "graph_manifest_required_fields": ["graph_key", "circuit", "graph_path", "graph_sha256"],
    "graph_payload_schema": "runtime-graph-v1 JSON with exact top-level fields schema_version,circuit,nodes,edge_index and exact per-node fields node_type,cell_type,sequential_flag",
    "action_uid_unique": true,
    "attempt_id_unique": true,
    "edge_pair_unique": ["action_uid", "attempt_id"],
    "every_edge_attempt_must_exist": true,
    "every_action_must_have_at_least_one_charged_attempt": true,
    "derived_files": {
      "features.tsv": "decision-time identifiers and allowlisted inputs only; no outcome or runtime columns",
      "outcomes.tsv": "action_uid plus execution, D95, cycles, charged runtime and epsilon labels",
      "combined_dataset_file_allowed": false
    },
    "epsilon_hit_derived_after_validation": true,
    "raw_candidate_rows_in_git_allowed": false,
    "manifest_must_bind_every_file_sha256": true
  },
  "runtime_accounting": {
    "charge_all_attempts": true,
    "failed_attempt_elapsed_is_charged": true,
    "retry_elapsed_is_charged": true,
    "select_fastest_success": false,
    "timeout_retry_allowed": false,
    "timeout_cost_if_elapsed_available": "observed_process_elapsed_s",
    "timeout_cost_if_elapsed_missing": "configured_stage_timeout_s",
    "not_run_stage_creates_zero_cost_attempt": false,
    "deduplicate_same_attempt_within_one_action": true,
    "reuse_historical_attempt_across_action_invocations_for_free": false,
    "unknown_retry_order_allowed": false,
    "success_only_source_requires_no_omitted_failure_or_retry_proof": true,
    "missing_runtime_imputation_allowed": false,
    "prefix_reuse": {
      "effective": false,
      "reason": "No audited restore/load elapsed and exact session event order are frozen for the retrospective package.",
      "same_for_all_methods": true,
      "zero_cost_restore_allowed": false,
      "future_enable_requires": [
        "exact_content_addressed_prefix_key",
        "first_materialization_elapsed",
        "every_restore_or_load_elapsed",
        "same_search_session_event_order"
      ]
    }
  },
  "model": {
    "architecture": "GraphSAGE_circuit_encoder_plus_candidate_MLP_three_heads",
    "heads": {
      "d95": "binary_feasibility_logit",
      "cycles": "log1p_total_cycles_per_common_fault_on_d95_safe_rows_only",
      "runtime": "log1p_policy_charged_runtime_s"
    },
    "seeds": [20260824, 20260825, 20260826],
    "seed_selection_allowed": false,
    "ensemble_rule": "arithmetic_mean_predictions_across_all_three_fixed_seeds",
    "normalization_fit_role": "TRAIN",
    "hyperparameter_selection_role": "VALIDATION",
    "pilot_or_blind_for_hyperparameters_allowed": false,
    "final_refit_includes_validation": false,
    "deterministic_algorithms_required": true,
    "fixed_threads_required": true
  },
  "baselines": {
    "architecture_baseline": "scalar_XGBoost_with_identical_allowlisted_non_graph_features",
    "registered_methods": ["fixed_heuristic", "d95_safe_then_predicted_cycles", "d95_safe_cost_aware_topk"],
    "fixed_heuristic_order": [
      "action_scheme_HMF_before_HF",
      "h_limit_fraction_desc",
      "m_limit_fraction_desc",
      "action_uid_lexicographic_asc"
    ],
    "all_methods_use_identical_action_space_hash": true,
    "method_specific_action_exclusion_allowed": false
  },
  "validation_replay": {
    "ranking_freeze_manifest_required": true,
    "ranking_freeze_manifest_binds": ["features_sha256", "ranking_sha256", "training_contract_sha256", "split_contract_sha256", "ranking_generator_path", "ranking_generator_sha256", "preoutcome_receipt_path", "preoutcome_receipt_sha256", "all_three_methods"],
    "preoutcome_receipt_required": true,
    "outcome_access_hash_chain_ledger_required": true,
    "ranking_generator_reads_outcomes": false,
    "ranking_is_frozen_before_outcome_access": true,
    "charge_action_before_reading_its_outcome": true,
    "stop_at_first_successful_d95_safe_epsilon_hit": true,
    "no_hit_at_k_success": 0,
    "no_hit_at_k_cost": "sum_all_charged_action_attempts_through_k",
    "fallback_cost_in_primary": false,
    "aggregation_unit": "family",
    "aggregation": "family_equal_macro_average"
  },
  "output_boundary": {
    "fresh_root_template": "/ssd/cjc/gnn_model_runtime_v1_<commit>_<timestamp>",
    "fresh_root_must_not_exist": true,
    "checkpoint_files_in_git_allowed": false,
    "git_allowed": ["code", "contracts", "small_aggregate_metrics", "paths", "sha256_receipts"],
    "receipt_must_bind": [
      "git_commit", "training_contract_sha256", "dataset_manifest_sha256", "split_sha256",
      "runtime_policy_sha256", "feature_schema_sha256", "dependency_lock_sha256",
      "environment_versions", "determinism_flags", "seed", "model_config",
      "preprocessor_sha256", "checkpoint_sha256", "validation_metrics_sha256", "replay_receipt_sha256"
    ],
    "blind_rows_read_must_be_false": true
  },
  "claim_boundary": {
    "retrospective_package_claim": "within-circuit candidate ordering and offline replay only",
    "cross_environment_absolute_runtime_calibration_claim_allowed": false,
    "prospective_same_environment_evidence_required_for_absolute_runtime_claim": true
  },
  "execution_gates": {
    "dataset_manifest_frozen_and_independently_reviewed": false,
    "success_only_retry_completeness_proved": false,
    "graph_manifest_frozen": false,
    "dependency_lock_frozen": false,
    "trainer_and_replay_tests_pass": false,
    "checkpoint_receipt_validator_frozen": false,
    "independent_code_review_pass": false
  },
  "training_execution_allowed": false,
  "lsf_or_tessent_allowed": false,
  "blind_candidate_access_allowed": false
}
