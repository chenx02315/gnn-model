{
  "schema_version": "blind-runtime-unseal-v3",
  "status": "SEALED_ONE_SHOT_COVERAGE_AUDIT_ONLY",
  "supersedes": {
    "contract": "contracts/blind_runtime_unseal_v2.json",
    "sha256": "e8ecdd4d7b19487959353d4868d52ab57ad117a49537ba383e506555b4144544",
    "reason": "v2 did not distinguish future recommendation methods from HF/HMF measurement schemes and therefore could not define a valid per-method receipt"
  },
  "purpose": "Run one model-independent sealed join to decide R06 and R07 and to freeze one runtime-eligible action-space hash per BLIND circuit. Decide R13 after reseal by binding every preregistered recommendation method to those same circuit hashes.",
  "scope": {
    "split_contract": "contracts/data_split_v1.json",
    "formal_runtime_membership_sha256": "c8f589d67d80470dcf49ffbcab51da763162e9ae82af0308b36d6771cbd97cac",
    "method_registry": "contracts/recommendation_method_registry_v1.json",
    "method_registry_sha256": "8fb8d4a90981c2479e3e6ea3a8a4669286080e921ad0c2ff8d82e8a2a5c4191f",
    "blind_circuits": ["s9234", "s38584", "wb_dma"],
    "blind_circuit_count": 3
  },
  "preconditions": {
    "required_split_sealed": true,
    "required_assessment": "contracts/runtime_recovery_gate_assessment_v1.json",
    "required_assessment_status": "BLOCKED",
    "required_check_status": {
      "R01": "PASS",
      "R02": "PASS",
      "R03": "PASS",
      "R04": "PASS",
      "R05": "PASS",
      "R08": "PASS",
      "R09": "PASS",
      "R10": "PASS",
      "R11": "PASS",
      "R12": "PASS",
      "R14": "PASS"
    },
    "checks_measured_by_one_shot_audit": ["R06", "R07"],
    "check_derived_after_reseal": "R13",
    "only_checks_allowed_to_remain_nonpass_before_unseal": ["R06", "R07", "R13"],
    "p0_remains_blocked": true
  },
  "one_shot_protocol": {
    "maximum_unseal_attempts": 1,
    "replay_allowed": false,
    "permitted_operation": "coverage-only candidate-stage-to-runtime-attempt join audit",
    "in_memory_candidate_rows_only": true,
    "candidate_level_output_allowed": false,
    "permitted_derivations": [
      "executed-stage action count",
      "unique runtime-join count",
      "missing runtime-join count",
      "ambiguous runtime-join count",
      "one frozen runtime-eligible action-space hash per circuit"
    ],
    "atomic_release": "Release one final aggregate receipt only after all three circuits complete; do not release partial per-circuit results.",
    "failure_action": "Immediately reseal; release one failed aggregate receipt with no partial per-circuit values; do not retry under this contract."
  },
  "prohibited": {
    "outcome_or_runtime_fields": [
      "elapsed",
      "wall_time",
      "user_time",
      "system_time",
      "runtime_value",
      "timeout_outcome",
      "pass_fail_outcome",
      "coverage_outcome",
      "fault_coverage",
      "pattern_count",
      "candidate_rank"
    ],
    "uses": [
      "training",
      "feature_selection",
      "model_selection",
      "hyperparameter_tuning",
      "threshold_tuning",
      "candidate_order_tuning",
      "calibration",
      "early_stopping",
      "performance_comparison"
    ],
    "release_forms": [
      "candidate_level_records",
      "candidate_to_attempt_mapping",
      "per_candidate_join_status",
      "method_specific_blind_subset",
      "paths",
      "run_ids",
      "raw_logs"
    ]
  },
  "allowed_receipt": {
    "aggregation": "one atomic receipt with one row per BLIND circuit; recommendation methods do not appear in the unseal receipt",
    "circuit_row_fields": [
      "circuit",
      "executed_stage_action_count",
      "unique_runtime_join_count",
      "missing_runtime_join_count",
      "ambiguous_runtime_join_count",
      "coverage_rate",
      "frozen_runtime_eligible_action_space_sha256",
      "source_artifact_set_sha256"
    ],
    "envelope_fields": [
      "schema_version",
      "status",
      "formal_runtime_membership_sha256",
      "method_registry_sha256",
      "tool_sha256",
      "contract_sha256",
      "receipt_sha256"
    ],
    "forbid_outcomes": true
  },
  "decision_rules": {
    "R06": {
      "pass_when": "For every BLIND circuit, ambiguous_runtime_join_count == 0.",
      "otherwise": "BLOCKED and reseal."
    },
    "R07": {
      "pass_when": "For every BLIND circuit, missing_runtime_join_count == 0, ambiguous_runtime_join_count == 0, unique_runtime_join_count == executed_stage_action_count, and coverage_rate == 1.0.",
      "otherwise": "BLOCKED and reseal."
    },
    "R13": {
      "pass_when": "After reseal, data/manifests/blind_runtime_method_binding_v1.json binds every method in the preregistered method registry to the exact per-circuit hashes from the atomic receipt, with no method-specific exclusion.",
      "otherwise": "BLOCKED; no training or evaluation."
    },
    "p0": "P0 remains BLOCKED until an independent assessment establishes every R01 through R14 as PASS."
  },
  "training_allowed": false
}
