  "scope": {
    "fixed_modes": ["H64", "M16", "F4"],
    "epsilon": 0.01,
    "train_roles": ["TRAIN"],
    "report_only_roles": ["VALIDATION"],
    "forbidden_roles": ["PILOT", "BLIND_TEST"],
    "train_circuits": ["aes_core", "s13207", "s15850", "s35932", "s38417", "spi"],
    "validation_circuits": ["s5378", "tv80"]
    ,"exact_role_family_mapping": {
      "TRAIN": {
        "aes_core": "iwls_aes_core",
        "s13207": "iscas89_s13207",
        "s15850": "iscas89_s15850",
        "s35932": "iscas89_s35932",
        "s38417": "iscas89_s38417",
        "spi": "iwls_spi"
      },
      "VALIDATION": {
        "s5378": "iscas89_s5378",
        "tv80": "iwls_tv80"
      }
    }
  },
  "safety": {
    "construction": "Every action admitted by runtime-training-package-v2 is independently verified D95-safe before model training.",
    "d95_head_present": false,
    "reason": "A D95 head would have one class because all 2521 formal actions are D95-safe; it is statistically unidentifiable and must not be presented as learned safety.",
    "model_may_override_candidate_safety": false,
    "all_actions_d95_safe_required": true,
    "unsafe_or_unknown_action_policy": "reject_before_feature_construction"
  },
  "features": {
    "candidate": [
      "scheme_hf",
      "scheme_hmf",
      "log1p_h_limit",
      "log1p_m_limit",
      "h_limit_fraction_of_circuit_max",
      "m_limit_fraction_of_circuit_max",
      "log1p_common_fault_count"
    ],
    "graph_raw": ["node_type", "cell_type", "sequential_flag", "edge_index"],
    "node_type_buckets": 16,
    "cell_type_hash_buckets": 64,
    "cell_hash": "sha256_utf8_mod_bucket_count",
    "normalization_fit_role": "TRAIN",
    "identifier_as_feature_allowed": false,
    "family_or_role_as_feature_allowed": false,
    "outcome_or_runtime_as_feature_allowed": false
  },
  "targets": {
    "epsilon_hit": "binary label defined by total_cycles <= 1.01 * same-circuit measured oracle cycles",
    "cycles": "log1p(total_cycles/common_fault_count)",
    "runtime": "log1p(policy_charged_runtime_s)",
    "target_roles": ["TRAIN"],
    "validation_targets_available_only_after_ranking_freeze": true
  },
  "graphsage": {
    "implementation": "pure_pytorch_mean_aggregation_without_torch_geometric",
    "layers": 2,
    "hidden_dim": 32,
    "graph_pool": "node_mean",
    "candidate_mlp_hidden": [32, 32],
    "fusion_mlp_hidden": [64, 32],
    "dropout": 0.0,
    "heads": ["epsilon_hit_logit", "normalized_cycles", "runtime"],
    "epochs": 120,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "positive_class_weight": "train_negative_count_divided_by_train_positive_count",
    "loss_weights": {"epsilon_hit": 1.0, "cycles": 1.0, "runtime": 1.0},
    "early_stopping_allowed": false
  },
  "xgboost_baseline": {
    "feature_boundary": "same allowlisted candidate scalar features; graph embedding and graph-derived scalars are excluded",
    "models": ["epsilon_hit_classifier", "cycles_regressor", "runtime_regressor"],
    "n_estimators": 300,
    "max_depth": 4,
    "learning_rate": 0.03,
    "subsample": 1.0,
    "colsample_bytree": 1.0,
    "n_jobs": 1,
    "tree_method": "hist"
  },
  "ranking": {
    "methods": ["fixed_heuristic", "predicted_cycles", "cost_aware"],
    "fixed_heuristic_order": ["scheme_hmf_desc", "h_limit_fraction_desc", "m_limit_fraction_desc", "action_uid_asc"],
    "predicted_cycles_order": ["predicted_cycles_asc", "action_uid_asc"],
    "cost_aware_score": "predicted_epsilon_hit_probability/max(predicted_runtime_s,1e-9)",
    "cost_aware_order": ["cost_aware_score_desc", "predicted_cycles_asc", "action_uid_asc"],
    "validation_ranking_must_be_frozen_before_outcome_access": true,
    "primary_endpoint": "cumulative_observed_policy_charged_runtime_s_to_first_epsilon_hit",
    "aggregation": "family_equal_macro_average",
    "top_k": 10,
    "no_hit_cost": "sum_observed_runtime_through_top_k"
  },
  "determinism": {
    "seeds": [20260824, 20260825, 20260826],
    "seed_selection_allowed": false,
    "ensemble": "arithmetic_mean_predictions_across_all_three_fixed_seeds",
    "python_hash_seed_equals_seed": true,
    "torch_deterministic_algorithms": true,
    "torch_threads": 1,
    "xgboost_threads": 1,
    "same_seed_prediction_sha256_must_match": true
  },
  "environment": {
    "fresh_root_template": "/ssd/cjc/gnn_model_runtime_v2_<commit>_<timestamp>",
