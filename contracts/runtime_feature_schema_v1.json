{
  "schema_version": "runtime-feature-schema-v1",
  "status": "FROZEN_IMPLEMENTATION_ONLY",
  "decision_time": "before_any_candidate_execution_in_the_search_session",
  "identifier_fields": [
    "action_uid",
    "circuit",
    "family",
    "role",
    "graph_key"
  ],
  "model_feature_allowlist": [
    "scheme_hf",
    "scheme_hmf",
    "log1p_h_limit",
    "log1p_m_limit",
    "h_limit_fraction_of_action_space_max",
    "m_limit_fraction_of_action_space_max",
    "log1p_common_fault_count",
    "graph_embedding"
  ],
  "graph_raw_allowlist": [
    "node_type",
    "cell_type",
    "sequential_flag",
    "edge_index"
  ],
  "leakage_blacklist": [
    "f_patterns",
    "actual_h_patterns",
    "actual_m_patterns",
    "actual_f_patterns",
    "h_cycles",
    "m_cycles",
    "f_cycles",
    "total_cycles",
    "detected_faults",
    "feasible_at_d95",
    "result_status",
    "wall_s",
    "user_s",
    "system_s",
    "rss_kb",
    "exit_status",
    "atpg_status",
    "timeout_status",
    "retry_order",
    "attempt_id",
    "retry_group_id",
    "source_artifact",
    "source_log_path",
    "source_log_sha256",
    "oracle_rank",
    "epsilon_hit",
    "h_full_patterns",
    "m_full_patterns",
    "f_full_patterns",
    "f_ratio"
  ],
  "identifier_as_feature_allowed": false,
  "family_or_role_as_feature_allowed": false,
  "full_pattern_features_allowed": false,
  "full_pattern_exception_rule": "A future version may allow a full-pattern field only after proving it is available before ranking and charging its generation cost to the primary endpoint.",
  "normalization_fit_role": "TRAIN",
  "pilot_or_blind_derived_normalization_allowed": false,
  "training_execution_allowed": false
}
